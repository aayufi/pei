import unittest
from decimal import Decimal
from pyspark.sql import functions as F


class SalesPipelineTests(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.spark = spark

        cls.customers = cls.spark.createDataFrame(
            [
                ("C1", "Alice", "alice@example.com", "123",
                 "Address", "Consumer", "USA", "NYC",
                 "NY", "10001", "East")
            ],
            [
                "customer_id", "customer_name", "email", "phone",
                "address", "segment", "country", "city",
                "state", "postal_code", "region"
            ]
        )

        cls.products = cls.spark.createDataFrame(
            [
                ("P1", "Furniture", "Chairs", "Office Chair",
                 "NY", Decimal("81.882"))
            ],
            [
                "product_id", "category", "sub_category",
                "product_name", "product_state", "price_per_product"
            ]
        )

        cls.orders = cls.spark.createDataFrame(
            [
                (1, "O1", "21/8/2016", "25/8/2016",
                 "Standard Class", "C1", "P1", 2,
                 Decimal("163.76"), Decimal("0.1"), Decimal("20.126")),

                (2, "O2", "23/9/2017", "29/9/2017",
                 "Standard Class", "UNKNOWN", "UNKNOWN", 1,
                 Decimal("100.00"), Decimal("0.0"), Decimal("10.125"))
            ],
            [
                "Row ID", "Order ID", "Order Date", "Ship Date",
                "Ship Mode", "Customer ID", "Product ID", "Quantity",
                "Price", "Discount", "Profit"
            ]
        )

    def test_order_date_parsing(self):
        result = transform_orders(self.orders)
        date_value = result.filter("row_id = 1").first()["order_date"]

        self.assertEqual(str(date_value), "2016-08-21")

    def test_profit_rounding_and_master_join(self):
        result = create_master_table(
            transform_orders(self.orders),
            self.customers,
            self.products
        )

        row = result.filter("row_id = 1").first()

        self.assertEqual(row["customer_name"], "Alice")
        self.assertEqual(row["category"], "Furniture")
        self.assertEqual(row["profit"], Decimal("20.13"))

    def test_unmatched_dimension_records_are_retained(self):
        result = create_master_table(
            transform_orders(self.orders),
            self.customers,
            self.products
        )

        self.assertEqual(result.count(), 2)

        unmatched = result.filter("row_id = 2").first()

        self.assertIsNone(unmatched["customer_name"])
        self.assertIsNone(unmatched["category"])

    def test_profit_aggregation(self):
        master = create_master_table(
            transform_orders(self.orders),
            self.customers,
            self.products
        )

        result = create_profit_aggregation(master)

        self.assertEqual(result.count(), 2)

        row = result.filter("order_year = 2016").first()

        self.assertEqual(row["total_profit"], Decimal("20.13"))

    def test_duplicate_customer_ids_are_detected(self):
        duplicate_customers = self.spark.createDataFrame(
            [("C1",), ("C1",)],
            ["customer_id"]
        )

        duplicates = duplicate_keys(
            duplicate_customers, "customer_id"
        )

        self.assertEqual(duplicates.count(), 1)

    def test_invalid_order_date_is_detected(self):
        invalid_orders = self.spark.createDataFrame(
            [(3, "O3", "invalid-date", "25/8/2016",
              "Standard Class", "C1", "P1", 1,
              Decimal("10.00"), Decimal("0.0"), Decimal("2.00"))],
            self.orders.schema
        )

        result = transform_orders(invalid_orders)

        self.assertIsNone(result.first()["order_date"])

    def test_empty_orders(self):
        empty_orders = self.orders.limit(0)
        result = transform_orders(empty_orders)

        self.assertEqual(result.count(), 0)


suite = unittest.TestLoader().loadTestsFromTestCase(SalesPipelineTests)
unittest.TextTestRunner(verbosity=2).run(suite)